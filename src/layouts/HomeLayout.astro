---
import Header from "../components/home/Header.astro";
import Footer from "../components/common/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="seedloaf-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Launch your own free Minecraft server in seconds. Enjoy a server with generous specs. Made by nerds, for nerds." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/documentation/images/Icon_A.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/documentation/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/documentation/favicon-192.png" />
    <link rel="apple-touch-icon" href="/documentation/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div>
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
