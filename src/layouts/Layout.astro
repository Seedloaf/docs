---
import SideBar from "../components/docs/SideBar.astro";
import DocsHeader from "../components/docs/DocsHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="seedloaf-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Launch your own free Minecraft server in seconds. Enjoy a server with generous specs. Made by nerds, for nerds." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/documentation/images/Icon_A.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/documentation/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/documentation/favicon-192.png" />
    <link rel="apple-touch-icon" href="/documentation/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Seedloaf</title>
  </head>
  <body>
    <div class="drawer lg:drawer-open">
      <input id="my-drawer-2" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col">
        <DocsHeader />
        <slot />
      </div>
      <SideBar />
    </div>
  </body>
</html>

<style>
  * {
    scroll-behavior: smooth;
  }
</style>
