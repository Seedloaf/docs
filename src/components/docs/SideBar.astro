---
import { getSidebar } from "../../constants/sidebar";

const pathname = new URL(Astro.request.url).pathname;
const langMatch = pathname.match(/^\/documentation\/es(?:\/|$)/);
const lang = langMatch ? 'es' : 'en';
const SIDEBAR = getSidebar(lang);
---

<div class="drawer-side z-40 md:border-r md:border-[var(--line)]">
  <label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"
  ></label>
  <aside class="bg-base-100 min-h-screen w-80">
    <div
      class="bg-base-100/90 sticky top-0 z-20 items-center gap-2 px-4 py-2.5 backdrop-blur border-b border-[var(--line)] lg:flex"
    >
      <div class="flex items-center gap-3">
        <img
          src="/documentation/images/Icon_A.svg"
          alt="Seedloaf"
          height={30}
          width={31}
          class="shrink-0"
        />
        <h3 class="text-[21px] font-bold tracking-[-0.025em]">
          <a href="/">Seedloaf</a>
        </h3>
      </div>
    </div>

    <ul class="menu w-full gap-1 px-4 py-4">
      {
        SIDEBAR.map((navItem) => (
          <li>
            <h2 class="eyebrow px-2 pt-4 pb-1 pointer-events-none">{navItem.title}</h2>
            <ul class="space-y-0.5">
              {navItem.items.map((navItem) => {
                const active = pathname === navItem.href;
                return (
                  <li class="flex flex-col">
                    <a
                      href={navItem.href}
                      class={`rounded-[var(--radius-selector)] px-3 py-1.5 text-[15px] transition-colors ${
                        active
                          ? "bg-[var(--accent-soft)] font-semibold text-[var(--accent-hi)]"
                          : "text-[var(--txt-3)] hover:bg-base-300 hover:text-base-content"
                      }`}
                    >
                      {navItem.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
    </ul>
  </aside>
</div>
